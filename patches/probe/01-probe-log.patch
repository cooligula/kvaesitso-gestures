--- /dev/null
+++ b/app/ui/src/main/java/de/mm20/launcher2/ui/probe/ProbeLog.kt
@@ -0,0 +1,100 @@
+package de.mm20.launcher2.ui.probe
+
+import android.content.Context
+import android.os.Build
+import android.os.Process
+import android.util.Log
+import java.io.File
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.concurrent.Executors
+
+/**
+ * Diagnostic log of the probe build. Lines are appended to one file per day in the app's files
+ * directory, so that a log of a whole day can be shared afterwards (see [ProbeExportActivity]).
+ */
+object ProbeLog {
+    private const val TAG = "KvProbe"
+    private const val MAX_FILE_BYTES = 8L * 1024 * 1024
+    private const val KEEP_FILES = 7
+
+    private val pid = Process.myPid()
+    private val executor = Executors.newSingleThreadExecutor { r ->
+        Thread(r, "probe-log").apply { isDaemon = true }
+    }
+
+    @Volatile
+    private var dir: File? = null
+
+    fun init(context: Context) {
+        if (dir != null) return
+        synchronized(this) {
+            if (dir != null) return
+            val d = File(context.applicationContext.filesDir, "probe")
+            d.mkdirs()
+            dir = d
+            try {
+                d.listFiles { f -> f.name.startsWith("probe-") }
+                    ?.sortedBy { it.name }
+                    ?.dropLast(KEEP_FILES)
+                    ?.forEach { it.delete() }
+            } catch (e: Exception) {
+                Log.e(TAG, "Cannot prune", e)
+            }
+            val previous = Thread.getDefaultUncaughtExceptionHandler()
+            Thread.setDefaultUncaughtExceptionHandler { thread, throwable ->
+                write(System.currentTimeMillis(), thread.name, "CRASH", Log.getStackTraceString(throwable))
+                previous?.uncaughtException(thread, throwable)
+            }
+        }
+        log(
+            "process",
+            "start pid=$pid ${Build.MANUFACTURER} ${Build.MODEL} api=${Build.VERSION.SDK_INT} " +
+                    "${Build.DISPLAY} fingerprint=${Build.FINGERPRINT}"
+        )
+    }
+
+    fun log(tag: String, message: String) {
+        if (dir == null) return
+        val now = System.currentTimeMillis()
+        val thread = Thread.currentThread().name
+        Log.d(TAG, "$tag: $message")
+        try {
+            executor.execute { write(now, thread, tag, message) }
+        } catch (e: Exception) {
+            // The executor can not run anymore; there is nothing left to do
+        }
+    }
+
+    private fun write(time: Long, thread: String, tag: String, message: String) {
+        val d = dir ?: return
+        try {
+            val date = Date(time)
+            val file = File(d, "probe-" + SimpleDateFormat("yyyyMMdd", Locale.US).format(date) + ".log")
+            if (file.length() > MAX_FILE_BYTES) return
+            val stamp = SimpleDateFormat("HH:mm:ss.SSS", Locale.US).format(date)
+            file.appendText("$stamp [$pid/$thread] $tag: $message\n")
+        } catch (e: Exception) {
+            Log.e(TAG, "Cannot write", e)
+        }
+    }
+
+    /**
+     * Puts all logs into a single file that can be shared.
+     */
+    fun export(context: Context): File? {
+        val d = dir ?: return null
+        val out = File(context.cacheDir, "kvaesitso-probe.log")
+        return try {
+            out.delete()
+            d.listFiles { f -> f.name.startsWith("probe-") }
+                ?.sortedBy { it.name }
+                ?.forEach { out.appendText(it.readText()) }
+            out
+        } catch (e: Exception) {
+            Log.e(TAG, "Cannot export", e)
+            null
+        }
+    }
+}

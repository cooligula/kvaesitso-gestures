@@ -0,0 +1,31 @@
+package de.mm20.launcher2.ui.probe
+
+import android.app.Activity
+import android.content.Intent
+import android.os.Bundle
+import androidx.core.content.FileProvider
+
+/**
+ * Shares the log of the probe build. It has an icon of its own, "Probe log".
+ */
+class ProbeExportActivity : Activity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        ProbeLog.init(this)
+        ProbeLog.log("export", "log shared")
+        val file = ProbeLog.export(this)
+        if (file != null) {
+            val uri = FileProvider.getUriForFile(this, "$packageName.fileprovider", file)
+            val send = Intent(Intent.ACTION_SEND).apply {
+                type = "text/plain"
+                putExtra(Intent.EXTRA_STREAM, uri)
+                addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+            }
+            startActivity(
+                Intent.createChooser(send, "Kvaesitso probe log")
+                    .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+            )
+        }
+        finish()
+    }
+}
diff --git a/app/ui/src/main/java/de/mm20/launcher2/ui/probe/ProbeLog.kt b/app/ui/src/main/java/de/mm20/launcher2/ui/probe/ProbeLog.kt

+package de.mm20.launcher2.ui.launcher.transitions
+
+import android.graphics.Bitmap
+import android.util.Log
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.size
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.withFrameNanos
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.drawWithContent
+import androidx.compose.ui.graphics.asAndroidBitmap
+import androidx.compose.ui.graphics.rememberGraphicsLayer
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.unit.IntSize
+import kotlinx.coroutines.CancellationException
+
+/**
+ * Composes [content] without showing it, and passes a bitmap of it to [onSnapshot].
+ */
+@Composable
+internal fun IconSnapshot(
+    size: IntSize,
+    onSnapshot: (Bitmap?) -> Unit,
+    content: @Composable () -> Unit,
+) {
+    val density = LocalDensity.current
+    val layer = rememberGraphicsLayer()
+    Box(
+        modifier = Modifier
+            .size(
+                with(density) { size.width.toDp() },
+                with(density) { size.height.toDp() },
+            )
+            .drawWithContent {
+                // Record the content, but do not draw it.
+                layer.record { this@drawWithContent.drawContent() }
+            },
+        contentAlignment = Alignment.Center,
+    ) {
+        content()
+    }
+    LaunchedEffect(layer) {
+        // Give the content a few frames to be composed, laid out and recorded.
+        repeat(3) { withFrameNanos { } }
+        try {
+            onSnapshot(layer.toImageBitmap().asAndroidBitmap())
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.e("IconSnapshot", "Cannot render the icon", e)
+            onSnapshot(null)
+        }
+    }
+}

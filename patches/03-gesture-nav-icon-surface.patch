+package de.mm20.launcher2.ui.launcher.transitions
+
+import android.content.ComponentName
+import android.graphics.Bitmap
+import android.graphics.Paint
+import android.graphics.PixelFormat
+import android.graphics.PorterDuff
+import android.graphics.RectF
+import android.os.Handler
+import android.os.Looper
+import android.os.Message
+import android.os.Messenger
+import android.util.Log
+import android.view.SurfaceControl
+import android.view.SurfaceHolder
+import android.view.SurfaceView
+import android.view.ViewGroup
+import android.view.Window
+import android.widget.FrameLayout
+import androidx.compose.ui.graphics.toAndroidRect
+import androidx.compose.ui.unit.IntRect
+import com.android.launcher3.GestureNavContract
+
+/**
+ * The icon that the system animates to when swiping home. Like the Launcher3 does, the icon is
+ * drawn on a surface of its own. This surface is handed over to the system, which moves it
+ * together with the window of the app that is closing. That way, the icon and the window stay in
+ * sync, which they can not if both are animated independently.
+ *
+ * The system tells us when its animation is done, and the surface is removed again.
+ */
+internal class GestureNavIconSurface(
+    private val window: Window,
+    /**
+     * Called with the app whose icon is on the surface, and with null when the surface is gone.
+     * The launcher hides its own icons of that app in between.
+     */
+    private val onIconVisible: (ComponentName?) -> Unit,
+) : SurfaceHolder.Callback {
+
+    private val handler = Handler(Looper.getMainLooper())
+
+    private val finishMessenger = Messenger(Handler(Looper.getMainLooper()) { message ->
+        if (message.what == MSG_FINISHED) {
+            close()
+            true
+        } else false
+    })
+
+    private val paint = Paint(Paint.FILTER_BITMAP_FLAG or Paint.ANTI_ALIAS_FLAG)
+    private val closeRunnable = Runnable { close() }
+
+    private var contract: GestureNavContract? = null
+    private var surfaceView: SurfaceView? = null
+    private var position = RectF()
+    private var icon: Bitmap? = null
+
+    /**
+     * Shows the surface at [bounds] and tells the system about it.
+     * @return false if the surface could not be shown. Nothing has been sent in that case.
+     */
+    fun show(contract: GestureNavContract, bounds: IntRect): Boolean {
+        close()
+
+        val parent = window.findViewById<ViewGroup>(android.R.id.content) ?: return false
+        val view = SurfaceView(window.context).apply {
+            setZOrderOnTop(true)
+            holder.setFormat(PixelFormat.TRANSLUCENT)
+            holder.addCallback(this@GestureNavIconSurface)
+        }
+        parent.addView(
+            view,
+            FrameLayout.LayoutParams(bounds.width, bounds.height).apply {
+                leftMargin = bounds.left
+                topMargin = bounds.top
+            }
+        )
+
+        this.contract = contract
+        surfaceView = view
+        position = RectF(bounds.toAndroidRect())
+
+        // The position is known right away, the surface only later (surfaceCreated).
+        sendInfo(null)
+        onIconVisible(contract.componentName)
+        // Safety net in case the system never reports the end of its animation.
+        handler.postDelayed(closeRunnable, TIMEOUT_MS)
+        return true
+    }
+
+    /**
+     * Sets the bitmap that is drawn on the surface.
+     */
+    fun setIcon(bitmap: Bitmap) {
+        icon = bitmap
+        draw()
+    }
+
+    fun close() {
+        handler.removeCallbacks(closeRunnable)
+        contract = null
+        icon = null
+        onIconVisible(null)
+        val view = surfaceView ?: return
+        surfaceView = null
+        view.holder.removeCallback(this)
+        // One frame later, so that the icon of the launcher itself is on screen before this one is gone.
+        handler.postDelayed({ (view.parent as? ViewGroup)?.removeView(view) }, 16L)
+    }
+
+    private fun sendInfo(surfaceControl: SurfaceControl?) {
+        val finishCallback = Message.obtain().apply {
+            what = MSG_FINISHED
+            replyTo = finishMessenger
+        }
+        contract?.sendEndPosition(position, surfaceControl, finishCallback)
+    }
+
+    override fun surfaceCreated(holder: SurfaceHolder) {
+        draw()
+        val view = surfaceView ?: return
+        val surfaceControl = view.surfaceControl
+        if (surfaceControl.isValid) sendInfo(surfaceControl)
+    }
+
+    override fun surfaceChanged(holder: SurfaceHolder, format: Int, width: Int, height: Int) {
+        draw()
+    }
+
+    override fun surfaceDestroyed(holder: SurfaceHolder) {}
+
+    private fun draw() {
+        val holder = surfaceView?.holder ?: return
+        val bitmap = icon ?: return
+        if (!holder.surface.isValid) return
+        try {
+            val canvas = holder.lockHardwareCanvas() ?: return
+            try {
+                canvas.drawColor(0, PorterDuff.Mode.CLEAR)
+                canvas.drawBitmap(
+                    bitmap,
+                    null,
+                    RectF(0f, 0f, canvas.width.toFloat(), canvas.height.toFloat()),
+                    paint
+                )
+            } finally {
+                holder.unlockCanvasAndPost(canvas)
+            }
+        } catch (e: Exception) {
+            Log.e(TAG, "Cannot draw the icon", e)
+        }
+    }
+
+    private companion object {
+        const val TAG = "GestureNavIconSurface"
+        const val MSG_FINISHED = 0
+        const val TIMEOUT_MS = 2000L
+    }
+}

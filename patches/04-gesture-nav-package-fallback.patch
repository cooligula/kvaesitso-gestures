+    /**
+     * The activity that the app is closing from is not always the one with the icon on the home
+     * screen, for example a chat of a messenger. So after the activity itself, the other launcher
+     * activities of the same app are tried, as the stock launcher does with the whole package.
+     */
+    private fun candidates(contract: GestureNavContract, window: Window): Sequence<GestureNavContract> =
+        sequence {
+            yield(contract)
+            try {
+                val launcherApps = window.context.getSystemService(LauncherApps::class.java)
+                for (activity in launcherApps.getActivityList(contract.componentName.packageName, contract.user)) {
+                    if (activity.componentName != contract.componentName) {
+                        yield(contract.withComponent(activity.componentName))
+                    }
+                }
+            } catch (e: Exception) {
+                Log.w("EnterHomeTransition", "Cannot list the launcher activities", e)
+            }
+        }
